    "Marco Antonio Rulfo Castro"
  ],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Marcor360/Mi-Sitio-Web/issues"
  },
  "homepage": "https://github.com/Marcor360/Mi-Sitio-Web#readme",
  "dependencies": {
    "gsap": "^3.15.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "sass": "^1.106.0",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=10"
  }
