{
  "name": "mi-sitio-web",
  "version": "2.0.0",
  "private": true,
  "description": "Portafolio personal de Marco Antonio Rulfo Castro construido con React, Sass y GSAP",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr SRC/entry-server.jsx --outDir .vite/ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "node --test tests/seo.test.mjs",
    "test:browser": "node --test tests/browser.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Marcor360/Mi-Sitio-Web.git"
  },
  "author": "Marco Antonio Rulfo Castro",
